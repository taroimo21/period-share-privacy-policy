<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>moo AItan - Privacy Policy & Terms of Service</title>
    <style>
        :root {
            --sage: #6B8E7D;
            --sage-light: #e8f0ec;
            --slate: #5C6B7A;
            --bg: #FAF8F5;
            --text: #2c2c2c;
            --muted: #666;
            --border: #e0ddd8;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
        }
        header {
            background: var(--sage);
            color: #fff;
            text-align: center;
            padding: 2.5rem 1rem 2rem;
        }
        header h1 { font-size: 1.8rem; font-weight: 700; }
        header p { margin-top: 0.3rem; opacity: 0.85; font-size: 0.95rem; }
        nav {
            display: flex;
            justify-content: center;
            gap: 1rem;
            padding: 1rem;
            background: #fff;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 10;
        }
        nav a {
            text-decoration: none;
            color: var(--sage);
            font-weight: 600;
            padding: 0.4rem 1rem;
            border-radius: 6px;
            transition: background 0.2s;
        }
        nav a:hover, nav a.active { background: var(--sage-light); }
        .lang-switch {
            text-align: center;
            padding: 1rem;
        }
        .lang-switch button {
            background: none;
            border: 1.5px solid var(--sage);
            color: var(--sage);
            padding: 0.35rem 1rem;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .lang-switch button.active {
            background: var(--sage);
            color: #fff;
        }
        main {
            max-width: 720px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem;
        }
        section { display: none; }
        section.visible { display: block; }
        .policy-section {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1.2rem;
        }
        h2 {
            font-size: 1.4rem;
            color: var(--sage);
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--sage-light);
        }
        h3 {
            font-size: 1rem;
            color: var(--slate);
            margin-bottom: 0.6rem;
        }
        p, li { font-size: 0.92rem; color: var(--text); }
        ul { padding-left: 1.2rem; margin-bottom: 0.5rem; }
        li { margin-bottom: 0.3rem; }
        a { color: var(--sage); }
        .updated {
            text-align: center;
            color: var(--muted);
            font-size: 0.82rem;
            margin-bottom: 2rem;
        }
        footer {
            text-align: center;
            padding: 2rem 1rem;
            color: var(--muted);
            font-size: 0.8rem;
            border-top: 1px solid var(--border);
        }
        @media (max-width: 600px) {
            header h1 { font-size: 1.4rem; }
            main { padding: 0 1rem 3rem; }
            .policy-section { padding: 1.2rem; }
        }
    </style>
</head>
