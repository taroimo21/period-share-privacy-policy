    <script>
        let currentSection = 'privacy';
        let currentLang = 'en';

        function showSection(section) {
            currentSection = section;
            document.getElementById('nav-privacy').classList.toggle('active', section === 'privacy');
            document.getElementById('nav-terms').classList.toggle('active', section === 'terms');
            updateView();
        }

        function switchLang(lang) {
            currentLang = lang;
            document.getElementById('btn-en').classList.toggle('active', lang === 'en');
            document.getElementById('btn-ja').classList.toggle('active', lang === 'ja');
            updateView();
        }

        function updateView() {
            document.querySelectorAll('section').forEach(s => s.classList.remove('visible'));
            const target = document.getElementById(currentSection + '-' + currentLang);
            if (target) target.classList.add('visible');
        }
    </script>
